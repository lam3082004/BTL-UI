# --- Local / Docker Compose Postgres ---
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=password
DATABASE_NAME=numsense

# --- Hosted Postgres (Render, Neon, etc.) ---
# When set, host/user/password/database above are ignored.
#
# Render — Internal Database URL (Web Service + DB on Render, same private network):
#   postgresql://USER:PASSWORD@dpg-xxxx-a/DATABASE
#   (port defaults to 5432; usually no TLS — leave DATABASE_SSL unset or false)
#
# Render — External URL (connect from your laptop / non-Render):
#   postgresql://USER:PASSWORD@dpg-xxxx.region-postgres.render.com:5432/DATABASE
#   Often needs: DATABASE_SSL=true  OR  ?sslmode=require on the URL
#
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# DATABASE_SSL=true

# First deploy: set DATABASE_SYNCHRONIZE=true so TypeORM creates tables (or use migrations).
# After schema exists, set DATABASE_SYNCHRONIZE=false for safer production.
# DATABASE_SYNCHRONIZE=true

# Optional: SQLite for quick local runs (no Postgres)
# USE_SQLITE=true
# SQLITE_DB_PATH=dev.sqlite

# Google OAuth — callback must match exactly what you register in Google Cloud Console
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# Local:
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback
# Production:
# GOOGLE_CALLBACK_URL=https://numsense.onrender.com/auth/google/callback

# JWT — use a long random string in production (32+ characters)
JWT_SECRET=your_jwt_secret_key_here_min_32_chars

# Frontend — used for CORS (production: include your Vercel URL)
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173
# Where users land after Google login (usually same as primary frontend URL)
FRONTEND_PUBLIC_URL=http://localhost:5173

# Server — Render sets PORT automatically; local default is 3001
PORT=3001
NODE_ENV=development

# Demo children/parent seed (off in production unless set)
# SEED_DEMO_DATA=true
